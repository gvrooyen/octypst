#!/usr/bin/env bash
set -euo pipefail

readonly TYPST_VERSION="0.13.1"
readonly TYPST_ARCHIVE="typst-x86_64-unknown-linux-musl.tar.xz"
readonly TYPST_URL="https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/${TYPST_ARCHIVE}"

log_step() {
  printf '\n==> %s\n' "$1"
}

install_system_dependencies() {
  local package
  local missing_packages=()

  for package in ca-certificates curl fonts-lato fonts-liberation fonts-open-sans python3 xz-utils; do
    dpkg-query --show --showformat='${db:Status-Status}' "$package" 2>/dev/null | grep -qx installed || \
      missing_packages+=("$package")
  done

  if ((${#missing_packages[@]})); then
    sudo apt-get update
    sudo apt-get install --yes "${missing_packages[@]}"
  fi
}

install_typst() {
  local temporary_directory

  if command -v typst >/dev/null && [[ "$(typst --version)" == "typst ${TYPST_VERSION}"* ]]; then
    return
  fi

  temporary_directory="$(mktemp --directory)"
  trap 'rm -rf "$temporary_directory"' RETURN
  curl --fail --location --retry 3 --output "$temporary_directory/$TYPST_ARCHIVE" "$TYPST_URL"
  tar --extract --xz --file "$temporary_directory/$TYPST_ARCHIVE" --directory "$temporary_directory"
  install --mode=0755 "$temporary_directory/typst-x86_64-unknown-linux-musl/typst" /usr/local/bin/typst
  trap - RETURN
  rm -rf "$temporary_directory"
}

log_step "Checking system dependencies"
install_system_dependencies

log_step "Installing Typst ${TYPST_VERSION}"
install_typst

log_step "Verifying report build"
typst compile sample_report.typ /tmp/octyp-setup-check.pdf
rm -f /tmp/octyp-setup-check.pdf
python3 -c 'import ast, pathlib; ast.parse(pathlib.Path("scripts/pdf_preview.py").read_text())'

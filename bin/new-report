#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: new-report <destination>

Create a self-contained Octypst report folder at <destination>.
The destination must not already exist.
EOF
}

if (($# != 1)); then
  usage >&2
  exit 2
fi

destination="$1"
if [[ -z "$destination" ]]; then
  usage >&2
  exit 2
fi

if [[ "$destination" != /* ]]; then
  destination="$PWD/$destination"
fi

source_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
required_sources=(
  "$source_root/starter_report.typ"
  "$source_root/report-template.typ"
  "$source_root/octoco-report-brand.typ"
  "$source_root/scripts/pdf_preview.py"
  "$source_root/scripts/report_editor.py"
  "$source_root/editor/index.html"
  "$source_root/editor/app.bundle.js"
  "$source_root/.amp/services.yaml"
  "$source_root/AGENTS.md"
  "$source_root/assets/octoco-report"
  "$source_root/LICENSE"
)

for source in "${required_sources[@]}"; do
  if [[ ! -e "$source" ]]; then
    printf 'new-report: required source is missing: %s\n' "$source" >&2
    exit 1
  fi
done

if [[ -e "$destination" ]]; then
  printf 'new-report: destination already exists: %s\n' "$destination" >&2
  exit 1
fi

mkdir -p "$(dirname "$destination")"
mkdir "$destination"

cleanup_on_failure() {
  rm -rf "$destination"
}
trap cleanup_on_failure ERR

cp "$source_root/starter_report.typ" "$destination/report.typ"
cp "$source_root/report-template.typ" "$destination/"
cp "$source_root/octoco-report-brand.typ" "$destination/"
mkdir "$destination/scripts" "$destination/.amp" "$destination/editor"
cp "$source_root/scripts/pdf_preview.py" "$destination/scripts/"
cp "$source_root/scripts/report_editor.py" "$destination/scripts/"
cp "$source_root/editor/index.html" "$source_root/editor/app.bundle.js" "$destination/editor/"
cp "$source_root/.amp/services.yaml" "$destination/.amp/"
cp "$source_root/AGENTS.md" "$destination/"
mkdir "$destination/assets"
cp -R "$source_root/assets/octoco-report" "$destination/assets/"
cp "$source_root/LICENSE" "$destination/OCTYPST-LICENSE"
printf '*.pdf\n.amp/portals/\n.amp/preview/\n' > "$destination/.gitignore"
cat > "$destination/README.md" <<'EOF'
# Report

Build with `typst compile report.typ report.pdf`.

In an Amp orb, run `amp orb services ensure` from this folder. The Report preview portal watches `report.typ` and assets, updates page images without resetting scroll position, and provides an **Open PDF** link. The Report editor portal offers an explicit-save Typst editor beside the rendered pages, with an independent **Open PDF** link. Both previews retain the last good result if compilation fails. Inspect the cover and affected content pages after each visual change; check `amp orb service logs pdf-preview` or `amp orb service logs report-editor` for errors. Preview builds are ignored in `.amp/preview/`.

To select a different `.typ` file, add `env: {OCTYPST_PREVIEW_SOURCE: other.typ}` under `pdf-preview` or `env: {OCTYPST_EDITOR_SOURCE: other.typ}` under `report-editor` in `.amp/services.yaml` and restart that service. The editor requires `editor/app.bundle.js`, already included in this folder.
EOF

trap - ERR
printf 'Created report at %s\n' "$destination"
